---
import { site } from "../../data/site";
import { getNavigation } from "../../lib/strapi";
import type { GlobalSettings } from "../../types/strapi";
import Button from "../ui/Button.astro";
import SearchOverlay from "./SearchOverlay.astro";

interface Props {
  /* Transparent overlay mode: header floats over a full-bleed hero. */
  overlay?: boolean;
  settings: GlobalSettings;
}

const { overlay = false, settings } = Astro.props;
const logoSrc = settings.logoUrl ?? "/cck-logo.png";

// Editable header links from Strapi (falls back to site.ts).
const { headerLinks } = await getNavigation();
---

<header
  class:list={[
    "z-40",
    overlay
      ? "absolute inset-x-0 top-0"
      : "sticky top-0 border-b border-border bg-surface/90 backdrop-blur",
  ]}
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6"
  >
    <a href="/" class="flex items-center gap-3" aria-label={settings.siteName}>
      <img
        src={logoSrc}
        alt=""
        width="56"
        height="56"
        class="h-14 w-14 shrink-0 object-contain"
      />
      <span class="leading-tight">
        <span
          class:list={[
            "block text-lg font-extrabold tracking-tight",
            overlay ? "text-white" : "text-primary",
          ]}>{site.shortName}</span
        >
        <span
          class:list={[
            "block text-[11px]",
            overlay ? "text-white/70" : "text-muted-foreground",
          ]}>{settings.tagline}</span
        >
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary">
      {
        headerLinks.map((link) =>
          link.children?.length ? (
            <div class="group/nav relative">
              <button
                type="button"
                aria-haspopup="true"
                class:list={[
                  "inline-flex cursor-default items-center gap-1 text-sm font-medium transition-colors",
                  overlay
                    ? "text-white/85 group-focus-within/nav:text-white group-hover/nav:text-white"
                    : "text-foreground/80 group-focus-within/nav:text-accent group-hover/nav:text-accent",
                ]}
              >
                {link.label}
                <svg
                  class="h-3.5 w-3.5 transition-transform group-hover/nav:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </button>
              <div class="invisible absolute left-1/2 top-full -translate-x-1/2 pt-3 opacity-0 transition-opacity group-focus-within/nav:visible group-focus-within/nav:opacity-100 group-hover/nav:visible group-hover/nav:opacity-100">
                <div class="w-56 rounded-card border border-border bg-surface p-2 shadow-lg">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-md px-3 py-2 text-sm font-medium text-foreground/80 hover:bg-surface-muted hover:text-accent"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href ?? "/"}
              class:list={[
                "text-sm font-medium transition-colors",
                overlay
                  ? "text-white/85 hover:text-white"
                  : "text-foreground/80 hover:text-accent",
              ]}
            >
              {link.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <button
        type="button"
        data-search-open
        aria-label="Search the site"
        class:list={[
          "rounded-full p-2.5 transition-colors",
          overlay
            ? "text-white/85 hover:bg-white/10 hover:text-white"
            : "text-foreground/70 hover:bg-surface-muted hover:text-accent",
        ]}
      >
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
      <Button href="/contact" variant="primary" class="px-5 py-2.5">
        Contact
      </Button>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <button
        type="button"
        data-search-open
        aria-label="Search the site"
        class:list={[
          "rounded-md border p-2 transition-colors",
          overlay
            ? "border-white/30 text-white"
            : "border-border text-primary hover:bg-surface-muted",
        ]}
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>

      <!-- Mobile menu: CSS-only disclosure, Zero-JS -->
      <details class="group relative">
      <summary
        class:list={[
          "flex cursor-pointer items-center rounded-md border p-2 [&::-webkit-details-marker]:hidden",
          overlay ? "border-white/30 text-white" : "border-border text-primary",
        ]}
        aria-label="Toggle menu"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <div
        class="absolute right-0 mt-2 w-60 rounded-card border border-border bg-surface p-3 shadow-lg"
      >
        <nav class="flex flex-col" aria-label="Mobile">
          {
            headerLinks.map((link) =>
              link.children?.length ? (
                <div>
                  <span class="block px-3 pb-1 pt-2 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                    {link.label}
                  </span>
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block rounded-md py-2 pl-6 pr-3 text-sm font-medium text-foreground/80 hover:bg-surface-muted hover:text-accent"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              ) : (
                <a
                  href={link.href ?? "/"}
                  class="rounded-md px-3 py-2 text-sm font-medium text-foreground/80 hover:bg-surface-muted hover:text-accent"
                >
                  {link.label}
                </a>
              ),
            )
          }
          <Button href="/contact" variant="primary" class="mt-2 w-full"
            >Contact</Button
          >
        </nav>
      </div>
      </details>
    </div>
  </div>
</header>

<SearchOverlay />
