---
interface Props {
  title: string;
  align?: "left" | "center";
  class?: string;
}

const { title, align = "left", class: className } = Astro.props;
---

<div
  class:list={[
    "flex flex-col",
    align === "center" && "items-center text-center",
    className,
  ]}
>
  <h2 class="font-serif text-3xl font-bold tracking-tight text-primary sm:text-4xl lg:text-5xl">
    {title}
  </h2>
</div>
