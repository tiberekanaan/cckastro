---
export const prerender = false;

import { marked } from "marked";
import BaseLayout from "../layouts/BaseLayout.astro";
import { STRAPI_URL, mediaUrl, richTextToPlain } from "../lib/strapi";
import type {
  Project,
  UafPage,
  StrapiCollectionResponse,
} from "../types/strapi";

let page: UafPage | null = null;
let projects: Project[] = [];
let loadError = false;

// Fetch the intro and the projects independently — a missing/unpublished UAF
// single type (404) must not blank out the project grid, and vice versa.
try {
  const res = await fetch(`${STRAPI_URL}/api/uaf-page`);
  if (res.ok) {
    const json: { data: UafPage | null } = await res.json();
    page = json.data ?? null;
  } else if (res.status !== 404) {
    throw new Error(`Strapi /api/uaf-page → ${res.status}`);
  }
} catch (err) {
  console.error("[universal-access] UAF intro fetch failed:", err);
}

try {
  const res = await fetch(`${STRAPI_URL}/api/projects?populate=photos`);
  if (!res.ok) throw new Error(`Strapi /api/projects → ${res.status}`);
  const json: StrapiCollectionResponse<Project> = await res.json();
  projects = json.data ?? [];
} catch (err) {
  console.error("[universal-access] projects fetch failed:", err);
  loadError = true;
}

const heading = page?.title ?? "Universal Access Fund";

// --- Sectioned layout for the long CMS description -------------------------
// The `description` richtext (Markdown) is split on `## ` headings and each
// section is rendered by content shape, not heading name, so editors can
// reorder/rename sections freely:
//   - only `- ` bullets            → two-column check-list
//   - `1. ` numbered list          → numbered cards (real sequences/steps)
//   - lone-number + title + text   → numbered cards (CMS pseudo-numbering)
//   - anything else                → prose (marked-rendered)
interface NumberedItem {
  num: string;
  title: string;
  sub: string[];
}
type Section =
  | { kind: "prose"; id: string; heading: string; html: string }
  | { kind: "checks"; id: string; heading: string; items: string[] }
  | { kind: "cards"; id: string; heading: string; cards: NumberedItem[] };

const slugifyHeading = (s: string): string =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");

const parseNumberedList = (lines: string[]): NumberedItem[] | null => {
  // Real Markdown ordered list: `1. Title` followed by `- sub` bullets.
  const cards: NumberedItem[] = [];
  for (const line of lines) {
    const item = line.match(/^(\d+)\.\s+(.*)$/);
    if (item) {
      cards.push({ num: item[1], title: item[2], sub: [] });
    } else if (/^[-*]\s+/.test(line) && cards.length > 0) {
      cards[cards.length - 1].sub.push(line.replace(/^[-*]\s+/, ""));
    } else {
      return null;
    }
  }
  return cards.length >= 2 ? cards : null;
};

const parsePseudoNumbered = (lines: string[]): NumberedItem[] | null => {
  // CMS pattern: a lone number line, a title line, then description text.
  const cards: NumberedItem[] = [];
  for (const line of lines) {
    if (/^\d+$/.test(line)) {
      cards.push({ num: line, title: "", sub: [] });
    } else if (cards.length === 0) {
      return null;
    } else if (!cards[cards.length - 1].title) {
      cards[cards.length - 1].title = line;
    } else {
      const card = cards[cards.length - 1];
      card.sub.push(card.sub.length ? `${card.sub.pop()} ${line}` : line);
    }
  }
  return cards.length >= 2 && cards.every((c) => c.title) ? cards : null;
};

async function buildSections(md: string): Promise<Section[]> {
  const parts = md.split(/^##\s+(.+)$/m);
  const sections: Section[] = [];

  const push = async (headingText: string, body: string): Promise<void> => {
    const text = body.trim();
    if (!text && !headingText) return;
    const id = slugifyHeading(headingText) || `section-${sections.length}`;
    const lines = text
      .split("\n")
      .map((l) => l.trim())
      .filter(Boolean);

    if (lines.length > 0 && lines.every((l) => /^[-*]\s+/.test(l))) {
      sections.push({
        kind: "checks",
        id,
        heading: headingText,
        items: lines.map((l) => l.replace(/^[-*]\s+/, "")),
      });
      return;
    }
    const cards = parseNumberedList(lines) ?? parsePseudoNumbered(lines);
    if (cards) {
      sections.push({ kind: "cards", id, heading: headingText, cards });
      return;
    }
    sections.push({
      kind: "prose",
      id,
      heading: headingText,
      html: await marked.parse(text),
    });
  };

  await push("", parts[0] ?? "");
  for (let i = 1; i < parts.length; i += 2) {
    await push(parts[i].trim(), parts[i + 1] ?? "");
  }
  return sections;
}

const sections: Section[] = page?.description
  ? await buildSections(page.description)
  : [];
const tocEntries = sections
  .filter((s) => s.heading)
  .map((s) => ({ id: s.id, heading: s.heading }));
const showToc = tocEntries.length >= 3;

const projectsIntroHtml = page?.projectsIntro
  ? await marked.parse(page.projectsIntro)
  : "";
const excerpt = (p: Project): string =>
  richTextToPlain(p.description).slice(0, 160);

const statusPill: Record<string, string> = {
  Completed: "bg-emerald-100 text-emerald-800",
  "Currently Implemented": "bg-sky-100 text-sky-800",
};

const proseClasses =
  "leading-relaxed text-muted-foreground [&_a]:text-accent [&_a]:underline [&_li]:mt-1 [&_p]:mt-4 [&_p:first-child]:mt-0 [&_strong]:text-primary [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-6";
---

<BaseLayout
  title={heading}
  description="Universal Access Fund projects bridging the connectivity gap across Kiribati."
>
  <section class="bg-surface-muted">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-20">
      <header class="max-w-3xl">
        <h1
          class="font-serif text-4xl font-bold leading-tight text-primary sm:text-5xl"
        >
          {heading}
        </h1>
      </header>

      {
        showToc && (
          <nav aria-label="On this page" class="mt-8 lg:hidden">
            <ul class="flex flex-wrap gap-2">
              {tocEntries.map((entry) => (
                <li>
                  <a
                    href={`#${entry.id}`}
                    class="inline-block rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-primary transition-colors hover:border-accent hover:text-accent"
                  >
                    {entry.heading}
                  </a>
                </li>
              ))}
              {projects.length > 0 && (
                <li>
                  <a
                    href="#projects"
                    class="inline-block rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-primary transition-colors hover:border-accent hover:text-accent"
                  >
                    Projects
                  </a>
                </li>
              )}
            </ul>
          </nav>
        )
      }

      <div
        class:list={[
          "mt-10 lg:mt-14",
          showToc && "lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-14",
        ]}
      >
        {
          showToc && (
            <nav aria-label="On this page" class="hidden lg:block">
              <div class="sticky top-24 border-l-2 border-slate-200 pl-5">
                <p class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">
                  On this page
                </p>
                <ul class="mt-4 space-y-2.5 text-sm">
                  {tocEntries.map((entry) => (
                    <li>
                      <a
                        href={`#${entry.id}`}
                        class="inline-block text-slate-600 transition-[color,transform] duration-200 hover:translate-x-1 hover:text-accent"
                      >
                        {entry.heading}
                      </a>
                    </li>
                  ))}
                  {projects.length > 0 && (
                    <li>
                      <a
                        href="#projects"
                        class="inline-block text-slate-600 transition-[color,transform] duration-200 hover:translate-x-1 hover:text-accent"
                      >
                        Projects
                      </a>
                    </li>
                  )}
                </ul>
              </div>
            </nav>
          )
        }

        <div class="space-y-14">
          {
            sections.map((section, index) => (
              <section id={section.id} class="scroll-mt-28">
                {section.heading && (
                  <h2 class="font-serif text-2xl font-bold text-primary sm:text-3xl">
                    <span
                      aria-hidden="true"
                      class="mb-3 block h-1 w-10 rounded-full bg-accent"
                    />
                    {section.heading}
                  </h2>
                )}

                {section.kind === "prose" && (
                  <div
                    class:list={[
                      "mt-5 max-w-3xl",
                      proseClasses,
                      index === 0 && "[&_p:first-child]:text-lg",
                    ]}
                    set:html={section.html}
                  />
                )}

                {section.kind === "checks" && (
                  <ul class="mt-6 grid gap-x-10 gap-y-3 sm:grid-cols-2">
                    {section.items.map((item) => (
                      <li class="flex items-start gap-3 text-muted-foreground">
                        <svg
                          aria-hidden="true"
                          class="mt-0.5 h-5 w-5 flex-none text-accent"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M16.704 5.29a1 1 0 0 1 .006 1.414l-7.2 7.3a1 1 0 0 1-1.42.004L3.29 9.21a1 1 0 1 1 1.42-1.408l2.086 2.104 6.494-6.586a1 1 0 0 1 1.414-.03Z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}

                {section.kind === "cards" && (
                  <ol
                    class:list={[
                      "mt-6 grid gap-5 sm:grid-cols-2",
                      section.cards.length % 3 === 0 && "lg:grid-cols-3",
                    ]}
                  >
                    {section.cards.map((card) => (
                      <li class="group relative overflow-hidden rounded-2xl border border-slate-100 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-accent/30 hover:shadow-md">
                        <span
                          aria-hidden="true"
                          class="pointer-events-none absolute -top-4 right-3 font-serif text-7xl font-bold leading-none text-primary/[0.08] transition-colors duration-300 group-hover:text-accent/20"
                        >
                          {card.num}
                        </span>
                        <h3 class="pr-12 font-semibold text-primary">
                          {card.title}
                        </h3>
                        {card.sub.length === 1 ? (
                          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                            {card.sub[0]}
                          </p>
                        ) : (
                          card.sub.length > 1 && (
                            <ul class="mt-3 space-y-1.5 text-sm text-muted-foreground">
                              {card.sub.map((line) => (
                                <li class="flex items-start gap-2.5">
                                  <span
                                    aria-hidden="true"
                                    class="mt-[0.55rem] h-1 w-1 flex-none rounded-full bg-accent"
                                  />
                                  <span>{line}</span>
                                </li>
                              ))}
                            </ul>
                          )
                        )}
                      </li>
                    ))}
                  </ol>
                )}
              </section>
            ))
          }
        </div>
      </div>

      <div id="projects" class="scroll-mt-28">
        {
          projectsIntroHtml && (
            <div class="mt-16 max-w-3xl border-l-4 border-accent pl-5">
              <h2 class="font-serif text-2xl font-bold text-primary">
                Universal Access Projects
              </h2>
              <div
                class="mt-3 leading-relaxed text-muted-foreground [&_a]:text-accent [&_a]:underline [&_li]:mt-1 [&_p]:mt-3 [&_strong]:text-primary [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-6"
                set:html={projectsIntroHtml}
              />
            </div>
          )
        }

        {
          projects.length > 0 && (
            <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div
                id="status-filter"
                role="group"
                aria-label="Filter projects by status"
                class="flex flex-wrap gap-2"
              >
                {
                  [
                    { label: "All", value: "all" },
                    { label: "Currently Implemented", value: "Currently Implemented" },
                    { label: "Completed", value: "Completed" },
                  ].map((option, index) => (
                    <button
                      type="button"
                      data-status={option.value}
                      aria-pressed={index === 0 ? "true" : "false"}
                      class="rounded-full border border-slate-200 bg-white px-4 py-1.5 text-xs font-semibold text-slate-600 transition-colors hover:border-accent hover:text-accent aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-white"
                    >
                      {option.label}
                    </button>
                  ))
                }
              </div>

              <label class="relative block sm:w-72">
                <span class="sr-only">Search projects</span>
                <svg
                  aria-hidden="true"
                  class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                >
                  <path
                    fill-rule="evenodd"
                    d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
                    clip-rule="evenodd"
                  />
                </svg>
                <input
                  id="project-search"
                  type="search"
                  placeholder="Search projects…"
                  autocomplete="off"
                  class="w-full rounded-full border border-slate-200 bg-white py-2.5 pl-11 pr-4 text-sm text-slate-700 shadow-sm placeholder:text-slate-400 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
                />
              </label>
            </div>
          )
        }

        {
          projects.length > 0 ? (
            <div
              id="projects-grid"
              class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
            >
              {projects.map((project, index) => (
                <a
                  href={`/projects/${project.slug ?? project.documentId}`}
                  data-reveal
                  data-reveal-delay={`${index * 100}ms`}
                  data-status={project.projectStatus ?? ""}
                  data-search={`${project.title ?? ""} ${excerpt(project)}`.toLowerCase()}
                  style={`animation-delay: ${index * 100}ms`}
                  class="group flex flex-col overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-xl"
                >
                  <div class="relative overflow-hidden">
                    <img
                      src={mediaUrl(project.photos?.[0]) ?? "/news-placeholder.svg"}
                      alt={
                        project.photos?.[0]?.alternativeText ??
                        project.title ??
                        "Project"
                      }
                      loading="lazy"
                      class="h-56 w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                    />
                    {project.projectStatus && (
                      <span
                        class={`absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-semibold shadow-sm ${statusPill[project.projectStatus] ?? "bg-slate-100 text-slate-700"}`}
                      >
                        {project.projectStatus}
                      </span>
                    )}
                  </div>

                  <div class="flex grow flex-col p-6">
                    <h2 class="mb-2 line-clamp-2 font-serif text-xl font-bold text-slate-900 transition-colors group-hover:text-teal-600">
                      {project.title}
                    </h2>
                    <p class="line-clamp-3 text-slate-600">{excerpt(project)}</p>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="mt-12 rounded-2xl border border-slate-100 bg-white p-12 text-center">
              <h2 class="font-serif text-2xl font-bold text-primary">
                {loadError ? "Projects are unavailable" : "No projects yet"}
              </h2>
              <p class="mt-3 text-muted-foreground">
                {loadError
                  ? "We couldn't load UAF projects. Please try again shortly."
                  : "Check back soon for the latest Universal Access Fund projects."}
              </p>
            </div>
          )
        }

        {
          projects.length > 0 && (
            <div
              id="projects-empty"
              hidden
              class="mt-8 rounded-2xl border border-slate-100 bg-white p-12 text-center"
            >
              <h2 class="font-serif text-2xl font-bold text-primary">
                No matching projects
              </h2>
              <p class="mt-3 text-muted-foreground">
                Try a different search term or choose another status.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Live project filtering — status chips + search input, no page reload.
  // Cards are all server-rendered; this only toggles their visibility.
  const grid = document.getElementById("projects-grid");
  const search = document.getElementById(
    "project-search",
  ) as HTMLInputElement | null;
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#status-filter button"),
  );
  const emptyState = document.getElementById("projects-empty");

  if (grid) {
    const cards = Array.from(
      grid.querySelectorAll<HTMLAnchorElement>("a[data-status]"),
    );
    let status = "all";
    let entranceCleared = false;

    const applyFilters = (): void => {
      // The staggered entrance animation replays whenever display flips back
      // from none — freeze it after the first interaction so filtering is
      // instant instead of re-revealing cards one by one.
      if (!entranceCleared) {
        cards.forEach((card) => (card.style.animation = "none"));
        entranceCleared = true;
      }
      const query = (search?.value ?? "").trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const matches =
          (status === "all" || card.dataset.status === status) &&
          (!query || (card.dataset.search ?? "").includes(query));
        card.style.display = matches ? "" : "none";
        if (matches) visible++;
      }
      if (emptyState) emptyState.hidden = visible > 0;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        status = button.dataset.status ?? "all";
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === button)),
        );
        applyFilters();
      });
    });
    search?.addEventListener("input", applyFilters);
  }
</script>

<style>
  /* Zero-JS staggered entrance — per-card delay set inline via animation-delay.
     `backwards` shows the initial frame during the delay, then reverts so the
     hover lift transform keeps working after entrance. */
  [data-reveal] {
    animation: reveal-up 0.6s ease-out backwards;
  }

  @keyframes reveal-up {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      animation: none;
    }
  }
</style>
